// Cloudflare deploy settings for the Tina's Little Angels parent portal.
// The portal is plain static files in ./public, so there is nothing to compile.
// Works with Cloudflare Workers (Git-connected "Workers Builds") via `npx wrangler deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tla-parent-portal",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
